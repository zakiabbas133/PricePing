{
  "expo": {
    "name": "Price Ping",
    "slug": "BinanceAlarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.uzairjamal.priceping",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.uzairjamal.priceping"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/alarm1.mp3", "./assets/sounds/alarm2.mp3"]
        }
      ],
      "expo-background-task",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Outfit-Regular.ttf",
            "./assets/fonts/Outfit-SemiBold.ttf",
            "./assets/fonts/Outfit-Medium.ttf",
            "./assets/fonts/Outfit-Bold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Outfit-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Outfit-SemiBold.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Outfit-Medium.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Outfit-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Outfit-Regular.ttf",
              "./assets/fonts/Outfit-SemiBold.ttf",
              "./assets/fonts/Outfit-Medium.ttf",
              "./assets/fonts/Outfit-Bold.ttf"
            ]
          }
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "ae4511eb-9ccc-4f70-8317-63c0dca0afc4"
      },
      "apiBaseUrl": "https://pricepingbackendservice.onrender.com",
      "localApiBaseUrl": "http://10.0.2.2:5009",
      "xApiKey": "pwfmha48UQ7WwkhgZ0E0Q7KrN6PiobLI2TkTEWoE"
    }
  }
}
